<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://www.w3.org/TR/REC-html40/loose.dtd">
<html><head><meta charset="UTF-8"></head><body><p>{% if settings.image.src is not empty %}
	{% set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}	
	{% set has_link = settings.link and settings.link.attributes is not empty %}
	{% if has_link %}
		&lt;{{ settings.link.tag | e('html_tag') }}
			{{ settings.link.attributes | raw }}
			class="{{ base_styles['link-base'] }}"
			data-interaction-id="{{ interaction_id }}"
		&gt;
	{% endif %}
	<img class="{{ base_styles['base'] }} {{ settings.classes | join(' ') }}" if not settings.link.href data-interaction-id="{{ interaction_id }}" endif id_attribute settings.attributes raw for attr value in settings.image src="https://alcesthe.github.io/my-portfolio/wp-content/plugins/elementor/modules/atomic-widgets/elements/atomic-image/value-efull_url" else e endfor>
	{% if has_link %}
		{{ settings.link.tag | e('html_tag') }}&gt;
	{% endif %}
{% endif %}
</p></body></html>
